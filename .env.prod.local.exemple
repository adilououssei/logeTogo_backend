# Modèle des secrets de production. Sur le serveur : copier en .env.prod.local (jamais dans Git)
# et remplacer chaque CHANGER_MOI (voir DEPLOIEMENT.md, qui donne les commandes pour les générer).

###> Base de données (conteneur mysql) ###
MYSQL_DATABASE=logetogo
MYSQL_USER=logetogo
MYSQL_PASSWORD=CHANGER_MOI
MYSQL_ROOT_PASSWORD=CHANGER_MOI
DATABASE_URL="mysql://logetogo:CHANGER_MOI@mysql:3306/logetogo?serverVersion=8.0.32&charset=utf8mb4"

###> Symfony ###
APP_SECRET=CHANGER_MOI
# Adresse publique : liens des emails (réponse au rappel de disponibilité…).
DEFAULT_URI=https://logetogo.zonalchd.org

###> Connexion de l'application (JWT) ###
JWT_PASSPHRASE=CHANGER_MOI

###> Emails ###
# Brevo : smtp://IDENTIFIANT:CLE@smtp-relay.brevo.com:587 — tant que ce n'est pas configuré : null://null
MAILER_DSN=null://null
MAILER_EXPEDITEUR="LogeTogo <no-reply@logetogo.zonalchd.org>"

###> Annonce vocale ###
# « aucune » : règles seules (rapides, sans IA). « ollama » nécessite un serveur Ollama (≈ 3 Go de mémoire).
ANNONCE_VOCALE_IA=aucune
