# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
DATABASE_URL="mysql://root:@127.0.0.1:3306/logeTogo_db?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Envoi des emails avec Mailtrap (https://mailtrap.io). Les vraies valeurs vont dans .env.local
# (développement) ou .env.docker.local (serveur), jamais ici.
#  - Sandbox (développement) : les emails arrivent dans une boîte de test Mailtrap, personne ne les reçoit.
#    MAILER_DSN=mailtrap+sandbox://JETON_API@default?inboxId=ID_DE_LA_BOITE
#  - Envoi réel (serveur, utilisé aussi par les testeurs Google Play) : domaine vérifié dans Mailtrap.
#    MAILER_DSN=mailtrap+api://JETON_API@default
# null://null : aucun email n'est envoyé (valeur par défaut, et celle des tests PHPUnit).
MAILER_DSN=null://null
# Adresse d'envoi des emails (code de mot de passe oublié, alertes…). Son domaine doit être
# vérifié dans Mailtrap (Sending Domains) : zonalchd.org l'est, logetogo.tg ne l'est pas.
MAILER_EXPEDITEUR="LogeTogo <no-reply@zonalchd.org>"

###> annonce vocale (IA open source, sur notre serveur) ###
# « ollama » : règles + IA (Ollama) ; « aucune » : règles seules (aucun serveur d'IA nécessaire).
ANNONCE_VOCALE_IA=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELE=qwen3:4b
OLLAMA_DELAI_SECONDES=120
# Temps de réponse visé (transcription + IA). L'IA n'est appelée que si les règles
# n'ont pas tout compris, et dans le temps restant ; sinon, résultat des règles seules.
ANNONCE_VOCALE_DELAI_SECONDES=30
# Serveur Whisper (voix → texte). Vide : seule la dictée au clavier est possible.
# Ex. whisper.cpp : http://localhost:8080/inference
WHISPER_URL=
WHISPER_DELAI_SECONDES=180
# Chemin complet de ffmpeg (conversion du M4A des téléphones en WAV). Vide : cherché dans le PATH.
FFMPEG_CHEMIN=
###< annonce vocale ###
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
# La vraie phrase secrète est dans .env.local (non versionné).
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> suivi de la disponibilité des annonces ###
# Rappel « toujours disponible ? » à l'annonceur, N jours après la publication ou la dernière confirmation.
DISPONIBILITE_RAPPEL_JOURS=7
# Sans réponse N jours après le rappel, l'annonce est retirée du public (« À confirmer »).
DISPONIBILITE_RETRAIT_JOURS=7
# Nombre de signalements « déjà loué / vendu » qui retirent l'annonce sans attendre.
DISPONIBILITE_SIGNALEMENTS=2
###< suivi de la disponibilité des annonces ###

###> symfony/mailtrap-mailer ###
# Voir MAILER_DSN plus haut (bloc symfony/mailer).
###< symfony/mailtrap-mailer ###

###> connexion avec Google ###
# ID client OAuth de type « Application Web » (Google Cloud, projet logetogo), séparés par des virgules.
# C'est l'audience des jetons envoyés par l'application (webClientId de Google Sign-In).
# Pas un secret (il est aussi dans l'application) : la même valeur sert en dev et sur le serveur.
# L'ID client « iOS » est aussi accepté : sur iPhone, Google peut émettre le jeton pour lui.
GOOGLE_CLIENT_IDS=437904106373-0cfdntd6tfr48japhsg8lcoeao5qhp1r.apps.googleusercontent.com,437904106373-5evhmte64ki683upnamaso46hebke9sv.apps.googleusercontent.com
###< connexion avec Google ###

###> connexion avec Apple ###
# Identifiant(s) de bundle de l'application iOS, séparés par des virgules : c'est l'audience
# des jetons « Se connecter avec Apple » envoyés par l'application. Pas un secret.
APPLE_CLIENT_IDS=com.oussadilou.logetogo
###< connexion avec Apple ###
